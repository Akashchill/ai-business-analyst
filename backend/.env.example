# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── AI (Vercel AI SDK) ────────────────────────────────────────
# Swap provider/model anytime — no code changes needed.
AI_PROVIDER=google
AI_MODEL=gemini-2.5-pro
GEMINI_API_KEY=your-gemini-api-key

# Optional — only if AI_PROVIDER=anthropic or openai
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Embeddings (always Google — used for RAG/pgvector)
AI_EMBED_MODEL=gemini-embedding-001
AI_EMBED_DIMENSIONS=1536

# Get a Gemini key at https://aistudio.google.com/apikey
# Used for chat (AI_MODEL) and gemini-embedding-001 (1536-dim vectors via pgvector)

# ── PostgreSQL ──────────────────────────────────────────────
# REQUIRED even if your analytics DB is MySQL — RAG document
# vectors are always stored in PostgreSQL via the pgvector
# extension (run migrations/001_rag_vector_setup.sql first).
# Supabase direct host (IPv6-only). On Windows/IPv4 networks, also set DB_POOLER_HOST
# from Dashboard → Database → Connection string → Session pooler (IPv4).
DB_HOST=db.your-project-ref.supabase.co
DB_POOLER_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Plain "postgres" is fine — app rewrites to postgres.<project-ref> when using the pooler.
DB_USER=postgres
# Must match Supabase Database password exactly (special chars like @ are OK as env vars).
# ECS: set the same value in the task definition — a typo here causes "password authentication failed".
DB_PASSWORD=your-db-password

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=super-secret-change-in-production
JWT_EXPIRES_IN=7d
# Require login for /api/agent/query and /api/schema (default: true)
ALLOW_ANONYMOUS_QUERY=false

# ── Document storage (AWS S3) ───────────────────────────────
# Store original uploaded files in a private S3 bucket.
# Set S3_ENABLED=false to run RAG without S3 (no download of originals).
S3_ENABLED=true
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-bucket-name
S3_PREFIX=documents/
# Optional for local/dev only. On ECS, omit these — the task IAM role is used.
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ── Database credentials (production) ───────────────────────
# Use a READ-ONLY DB user for analytics queries (SELECT-only on business tables).
# RAG document storage uses the same PostgreSQL pool (getPostgresPool) and needs
# INSERT/UPDATE on rag_* tables — use a separate write-capable role for migrations
# only, or grant SELECT on business tables + write on rag_* to the app user.
# Analytics SQL runs via getAdapter(dbType) — keep that connection read-only in prod.

